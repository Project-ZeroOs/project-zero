# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.bin binary
*.elf binary
*.o binary
*.a binary

# Source code files
*.rs text diff=rust
*.asm text
*.S text
*.ld text
*.py text diff=python
*.toml text
*.md text
*.yml text
*.yaml text
*.json text
